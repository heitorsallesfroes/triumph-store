{
  "manifest_version": 3,
  "name": "Triumph Store - Biblioteca WhatsApp",
  "version": "1.1.0",
  "description": "Painel lateral no WhatsApp Web com as mensagens, áudios e mídias da aba WhatsApp do ERP Triumph Store.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://jcnvlqfpmmejtzfhfjix.supabase.co/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
