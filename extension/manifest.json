{
  "manifest_version": 3,
  "name": "Triumph Store - Biblioteca WhatsApp",
  "version": "1.8.0",
  "description": "Painel lateral no WhatsApp Web com as mensagens, áudios e mídias da aba WhatsApp do ERP Triumph Store.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://jcnvlqfpmmejtzfhfjix.supabase.co/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["mic-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa-before.js", "vendor/wppconnect-wa.js", "wa-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
